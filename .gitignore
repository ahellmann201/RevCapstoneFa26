# ==========================================
# Node.js / npm
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Frontend / Vite
# ==========================================

dist/
dist-ssr/
*.local/
*.local

# ==========================================
# Python
# ==========================================

# Virtual environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==========================================
# Environment variables and secrets
# ==========================================

# Ignore environment files by default
.env
.env.*

# Allow safe example configurations
!.env.example
!.env.*.example

# Keep the shared test configuration only if it
# contains no secrets or sensitive credentials.
!.env.test

# ==========================================
# Local databases
# ==========================================

# SQLite database files
*.db
*.sqlite
*.sqlite3

# SQLite journal and temporary files
*.db-journal
*.db-shm
*.db-wal
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Database backups and dumps
*.bak
*.dump

# ==========================================
# Test reports and coverage
# ==========================================

coverage/
test-results/
playwright-report/
.nyc_output/

# ==========================================
